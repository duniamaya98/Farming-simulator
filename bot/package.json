{
  "name": "ninja-horizon-afk-bot",
  "version": "1.1.0",
  "description": "Headless AFK EXP, World Boss & Event Boss Bot untuk Ninja Horizon menggunakan bytecode asli mesin Oracle (Hermes v98)",
  "main": "bot.js",
  "scripts": {
    "extract": "python extract_oracle.py",
    "start": "node bot.js",
    "login": "node bot.js --login-google",
    "test": "node bot.js --test-sim",
    "status": "node bot.js --status",
    "missions": "node bot.js --list-missions",
    "bosses": "node bot.js --list-bosses",
    "wb": "node bot.js --wb",
    "wb:status": "node bot.js --wb-status",
    "event": "node bot.js --event"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
