{
  "name": "ninja-horizon-afk-bot",
  "version": "1.5.0",
  "description": "Headless AFK EXP, World Boss, Hunting House, Eudemon Garden, Shinobi Tower, Auto Exam, TP Training & SS Training Bot untuk Ninja Horizon menggunakan bytecode asli mesin Oracle (Hermes v98)",
  "main": "bot.js",
  "scripts": {
    "extract": "python extract_oracle.py",
    "start": "node bot.js",
    "login": "node bot.js --login-google",
    "test": "node bot.js --test-sim",
    "status": "node bot.js --status",
    "missions": "node bot.js --list-missions",
    "bosses": "node bot.js --list-bosses",
    "wb": "node bot.js --wb",
    "wb:status": "node bot.js --wb-status",
    "event": "node bot.js --event",
    "hunting": "node bot.js --hunting",
    "eudemon": "node bot.js --eudemon",
    "hunt:status": "node bot.js --hunt-status",
    "tower": "node bot.js --tower",
    "tower:status": "node bot.js --tower-status",
    "tower:sweep": "node bot.js --tower-sweep",
    "exam": "node bot.js --exam",
    "exam:status": "node bot.js --exam-status",
    "tp": "node bot.js --tp",
    "tp:status": "node bot.js --tp-status",
    "ss": "node bot.js --ss",
    "ss:status": "node bot.js --ss-status",
    "training": "node bot.js --training",
    "training:status": "node bot.js --training-status"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
